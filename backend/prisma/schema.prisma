generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  // ISO code (TND, EUR...). Amounts stay in thousandths whatever it is.
  currency     String   @default("TND")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  aiUsage       AiUsage[]
}

// A monthly spending limit for one category, repeated every month.
model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amount     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

// How many assistant messages a user sent on a given day (daily limit).
model AiUsage {
  userId String
  day    DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionSource {
  MANUAL
  CSV
  PDF
}

// Built-in categories have a `key` (translated by the frontend) and no name;
// categories the user creates have a name and no key.
model Category {
  id        String          @id @default(uuid())
  userId    String
  key       String?
  name      String?
  type      TransactionType
  icon      String
  color     String
  createdAt DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, key])
  @@index([userId])
}

// Amounts are stored in millimes (1 TND = 1000 millimes) as whole numbers,
// so sums are exact: no floating-point rounding errors.
model Transaction {
  id          String            @id @default(uuid())
  userId      String
  categoryId  String?
  type        TransactionType
  amount      Int
  date        DateTime          @db.Date
  description String
  note        String?
  source      TransactionSource @default(MANUAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
}

// One row per logged-in device. Only a hash of the token is stored, so a
// database leak does not let anyone reuse sessions.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}
