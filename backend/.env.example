DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/finance_tracker?schema=public"
JWT_ACCESS_SECRET="change-me-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"
FRONTEND_URL="http://localhost:5173"
PORT=3000
NODE_ENV=development
COOKIE_SAMESITE="lax"

# AI assistant (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
AI_DAILY_LIMIT=30

# Password reset emails. Gmail: turn on 2-step verification, create an app
# password (myaccount.google.com/apppasswords) and paste it in SMTP_PASS.
# Without SMTP or Resend, the reset link is printed in the server logs.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
MAIL_FROM=""
